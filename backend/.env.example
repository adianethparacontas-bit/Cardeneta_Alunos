# Copiem este ficheiro para .env e ajustem os valores.
# O .env nunca vai para o repositorio.

# Ambiente: development | test | production
NODE_ENV=development

# Porta do servidor
PORT=3000

# Pasta dos ficheiros JSON de dados (relativa a pasta backend)
DATA_DIR=./data

# Segredo para assinar os tokens de sessao (JWT). Tem de ter pelo menos 16
# caracteres. Em producao o arranque falha se ficar com o valor de exemplo.
SESSION_SECRET=trocar-por-um-segredo-longo-e-aleatorio

# Duracao da sessao, em horas
SESSION_DURACAO_HORAS=12

# Limite de tentativas de login: janela em minutos e maximo de falhas
LOGIN_JANELA_MINUTOS=15
LOGIN_MAX_TENTATIVAS=5
